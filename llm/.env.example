# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible chat endpoint works (Groq free tier by default).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-key-here
LLM_MODEL=openai/gpt-oss-120b
LLM_JUDGE_MODEL=qwen/qwen3.8-27b
LLM_TPM_LIMIT=8000

# Optional fallback providers (a DIFFERENT service, used on rate limits / errors)
# LLM2_BASE_URL=
# LLM2_API_KEY=
# LLM2_MODEL=
# LLM3_BASE_URL=
# LLM3_API_KEY=
# LLM3_MODEL=
